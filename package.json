{
  "name": "rpgmaker-decrypter",
  "version": "1.0.1",
  "description": "RPG Maker MV/MZ 资源解密、存档编辑与汉化辅助工具（Electron + TypeScript 重写）",
  "author": "LynxShu",
  "license": "MIT",
  "main": "out/main/index.js",
  "bin": {
    "rpgmaker-decrypter": "out/cli/index.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli/index.ts",
    "cli:test": "node scripts/prepare-cli-test.cjs && node scripts/verify-cli.cjs",
    "watch:test": "node node_modules/typescript/bin/tsc -p tsconfig.buildmain.json && node scripts/verify-watch.cjs && node scripts/verify-pool.cjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.3"
  }
}
