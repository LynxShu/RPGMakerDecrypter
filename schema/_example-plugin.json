{
  "name": "ExamplePlugin",
  "description": "示例 schema：复制本文件为 <你的插件名>.json 并去掉 _ 前缀即可生效（本文件以 _ 开头，不会被加载）",
  "fields": [
    {
      "path": "plugin.exampleFlag",
      "label": "Example flag",
      "type": "boolean",
      "description": "一个示例布尔字段"
    },
    {
      "path": "plugin.exampleCounter",
      "label": "Example counter",
      "type": "number",
      "min": 0,
      "max": 99999,
      "placeholder": "0"
    },
    {
      "path": "plugin.exampleNote",
      "label": "Example note",
      "type": "text",
      "placeholder": "free text"
    }
  ]
}
